# Service Systemd pour Téléinfo Linky

[Unit]
Description=Téléinfo Linky
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONNOUSERSITE=1
ExecStart=%h/linky/.venv/bin/teleinfo-linky
WorkingDirectory=%h/linky/
Restart=on-failure
# Sans délai, systemd abandonne après cinq échecs en dix secondes
RestartSec=10
TimeoutStopSec=1

[Install]
WantedBy=default.target
